<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.catscan.probe">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />
  <application android:label="Probe" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".ProbeActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name=".WrapActivity" android:exported="true" />
  </application>
</manifest>
