{
  "name": "@catscan/core-js",
  "version": "1.0.4",
  "description": "Shared Node layer of catscan: launches the catscan binary, talks to its serve process, renders results and maps them to exit codes. The base of @catscan/cli, @catscan/mcp and @catscan/playwright.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/gatalifeltd/catscan.git", "directory": "packages/core-js" },
  "homepage": "https://github.com/gatalifeltd/catscan#readme",
  "bugs": { "url": "https://github.com/gatalifeltd/catscan/issues" },
  "keywords": ["ui-testing", "visual-testing", "text-testing", "localization-testing", "ocr", "quality-assurance", "ci", "catscan", "screenshot-testing", "local-first", "apple-vision", "macos"],
  "main": "src/index.js",
  "files": ["src", "schema", "behavior-changes.json"],
  "engines": { "node": ">=22" },
  "scripts": { "prepack": "node ../../scripts/copy-schemas.mjs", "postpack": "node ../../scripts/copy-schemas.mjs --clean" },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@catscan/cli-darwin-arm64": "1.0.4"
  }
}
